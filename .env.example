# StockSense Environment Configuration
# ==============================================================================
# Supabase Client Configuration (Safe for frontend exposure via VITE_)
# ==============================================================================
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# ==============================================================================
# Optional Server-Side / AI Studio Configuration (DO NOT prefix with VITE_)
# ==============================================================================
# GEMINI_API_KEY: For Gemini AI insights and edge functions
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The base URL where the frontend is deployed
APP_URL="http://localhost:3000"
